# Sync FIFO at AW=2 (4 entries). Jasper: assert/cover properties, prove with Hp/N engines.
[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 12
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 12

[engines]
smtbmc z3

[script]
read -formal fifo.sv
chparam -set AW 2 -set DW 4 fifo
prep -top fifo

[files]
fifo.sv
